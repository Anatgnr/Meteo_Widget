{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Fenêtre locale WeatherGlass et accès limité aux fournisseurs météo publics",
  "windows": ["main"],
  "permissions": [
    "core:default", "core:window:allow-start-dragging", "core:window:allow-minimize",
    "core:window:allow-close", "core:window:allow-show",
    "autostart:default", "notification:default",
    { "identifier": "http:default", "allow": [
      { "url": "https://api.open-meteo.com/v1/forecast?*" },
      { "url": "https://geocoding-api.open-meteo.com/v1/search?*" },
      { "url": "https://api.rainviewer.com/public/weather-maps.json" }
    ]}
  ]
}
