{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WeatherGlass",
  "version": "0.1.0",
  "identifier": "fr.weatherglass.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main", "title": "WeatherGlass", "width": 320, "height": 180,
      "resizable": false, "skipTaskbar": true, "focus": false, "visible": false,
      "decorations": false, "transparent": true, "shadow": false,
      "alwaysOnTop": false, "alwaysOnBottom": true,
      "windowEffects": { "effects": ["acrylic"], "color": "#18181c18" },
      "backgroundColor": "#00000000"
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data: blob: https://tile.openstreetmap.org https://tilecache.rainviewer.com; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost https://api.open-meteo.com https://geocoding-api.open-meteo.com https://api.rainviewer.com"
    }
  },
  "bundle": {
    "active": true, "targets": ["nsis"],
    "shortDescription": "La météo et les prochaines pluies sur votre bureau",
    "windows": { "nsis": { "languages": ["French"], "displayLanguageSelector": false, "installMode": "currentUser" } },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
